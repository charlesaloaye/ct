# Production settings for charlestechy.com.
#   cp .env.production.example .env && nano .env
# Fill the REQUIRED values, then run: php artisan key:generate
# Mail and AI can be left empty here and set in Admin → Integrations instead.

APP_NAME=charlestechy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://charlestechy.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=charlestechy
DB_USERNAME=charlestechy
# REQUIRED: the password you gave the MySQL user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=charlestechy.com
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
MEDIA_DISK=public

# Email: either fill these, or choose SMTP in Admin → Integrations → Email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@charlestechy.com"
MAIL_FROM_NAME="Charles Aloaye Sedenu"

ADMIN_NAME="Charles Aloaye"
# REQUIRED: the admin sign-in
ADMIN_EMAIL=charlestechy0@gmail.com
# REQUIRED: 12+ characters, letters and numbers. Used once by db:seed; change it later in Admin → Account.
ADMIN_PASSWORD=
CONTACT_RECIPIENT=charlestechy0@gmail.com

CONTACT_RATE_PER_HOUR=5
SUBSCRIBE_RATE_PER_HOUR=5
EVENTS_RATE_PER_MINUTE=60

# AI: either fill these, or set them in Admin → Integrations → AI.
AI_PROVIDER=openai
AI_MAX_TOKENS=16000
AI_REQUESTS_PER_HOUR=20
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

INERTIA_SSR_ENABLED=false
