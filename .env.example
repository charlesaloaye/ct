APP_NAME=charlestechy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The site's address. Links in emails, the sitemap and share images are built from it.
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=charlestechy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Proxies whose X-Forwarded-* headers are trusted (rate limits need the real client IP).
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Uploads (images, CV). "public" = storage/app/public behind /storage. Use "s3" for S3/Spaces.
FILESYSTEM_DISK=local
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail. These are defaults: Admin → Integrations → Email overrides them without a redeploy.
# "log" writes emails to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@charlestechy.com"
MAIL_FROM_NAME="${APP_NAME}"

# The owner account created by `php artisan db:seed`. Pick a long, unique password.
ADMIN_NAME="Charles Aloaye"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where contact-form enquiries are emailed (defaults to the contact email in Site settings).
CONTACT_RECIPIENT=

# Public rate limits (per IP)
CONTACT_RATE_PER_HOUR=5
SUBSCRIBE_RATE_PER_HOUR=5
EVENTS_RATE_PER_MINUTE=60

# AI writing assistant. Defaults only: Admin → Integrations → AI overrides every value here,
# and keys saved there are stored encrypted. Keys never reach the browser.
AI_PROVIDER=openai
AI_MAX_TOKENS=16000
AI_REQUESTS_PER_HOUR=20

OPENAI_API_KEY=
# The model id from your OpenAI account (no default on purpose).
OPENAI_MODEL=
# Optional for reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=
OPENAI_ORGANIZATION=
OPENAI_TIMEOUT=300

ANTHROPIC_API_KEY=
# e.g. claude-opus-5-5
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_FALLBACKS=default
ANTHROPIC_TIMEOUT=300

# Inertia server-side rendering is not used (the server renders titles and meta tags for crawlers).
INERTIA_SSR_ENABLED=false
